generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TENANT
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ExpenseDistributionMethod {
  PER_APARTMENT
  PER_PERSON
  BY_CONSUMPTION
  BY_SURFACE
  CUSTOM
}

enum ExpenseCategory {
  COLD_WATER
  HOT_WATER
  GAS
  ELECTRICITY
  HEATING
  CLEANING
  ELEVATOR
  GARBAGE
  ROLLING_FUND
  REPAIR_FUND
  ADMINISTRATION
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum UtilityType {
  COLD_WATER
  HOT_WATER
  GAS
  ELECTRICITY
  HEATING
}

enum MaintenanceListStatus {
  DRAFT
  CALCULATED
  PUBLISHED
  CLOSED
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime    @default(now())

  apartments   Apartment[]

  managedAssociations Association[] @relation("AssociationAdmin")
}

model Association {
  id        String   @id @default(cuid())
  name      String
  address   String
  adminId   String
  createdAt DateTime @default(now())

  admin User @relation("AssociationAdmin", fields: [adminId], references: [id])

  apartments        Apartment[]
  expenses          Expense[]
  announcements     Announcement[]
  maintenanceLists  MaintenanceList[]
}

model Apartment {
  id                String   @id @default(cuid())
  associationId     String
  ownerId           String
  number            String
  floor             Int
  surface           Float
  numberOfResidents Int
  createdAt         DateTime @default(now())

  association Association @relation(fields: [associationId], references: [id])
  owner       User        @relation(fields: [ownerId], references: [id])

  consumptions Consumption[]
  meters       Meter[]
  invoices     Invoice[]
  tickets      Ticket[]
}

model Meter {
  id          String      @id @default(cuid())
  apartmentId String
  utilityType UtilityType
  createdAt   DateTime    @default(now())

  apartment Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  readings  MeterReading[]

  @@unique([apartmentId, utilityType])
}

model MeterReading {
  id           String   @id @default(cuid())
  meterId      String
  month        Int
  year         Int
  readingValue Decimal  @db.Decimal(12, 3)
  submittedAt  DateTime @default(now())

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, month, year])
}

model Consumption {
  id          String   @id @default(cuid())
  apartmentId String
  month       Int
  year        Int
  coldWater   Float   @default(0)
  hotWater    Float   @default(0)
  gas         Float   @default(0)
  electricity Float   @default(0)
  heating     Float   @default(0)
  submittedAt DateTime @default(now())

  apartment Apartment @relation(fields: [apartmentId], references: [id])

  @@unique([apartmentId, month, year])
}

model Expense {
  id                 String                    @id @default(cuid())
  associationId      String
  month              Int
  year               Int
  category           ExpenseCategory
  description        String
  totalAmount        Decimal                   @db.Decimal(10, 2)
  distributionMethod ExpenseDistributionMethod
  createdAt          DateTime                  @default(now())

  association Association @relation(fields: [associationId], references: [id])
}

model MaintenanceList {
  id            String                @id @default(cuid())
  associationId String
  month         Int
  year          Int
  status        MaintenanceListStatus @default(DRAFT)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  calculatedAt  DateTime?
  publishedAt   DateTime?
  closedAt      DateTime?

  association Association @relation(fields: [associationId], references: [id])

  invoices Invoice[]

  @@unique([associationId, month, year])
}

model Invoice {
  id                String        @id @default(cuid())
  maintenanceListId String
  apartmentId       String
  month             Int
  year              Int
  totalAmount       Decimal       @db.Decimal(10, 2)
  status            InvoiceStatus @default(UNPAID)
  generatedAt       DateTime      @default(now())
  paidAt            DateTime?

  maintenanceList MaintenanceList @relation(fields: [maintenanceListId], references: [id])

  apartment       Apartment @relation(fields: [apartmentId], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@unique([apartmentId, month, year])
  @@index([maintenanceListId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(10, 2)
  sourceType  String
  sourceId    String?

  expenseCategory     ExpenseCategory?
  distributionMethod  ExpenseDistributionMethod?
  sourceAmount        Decimal? @db.Decimal(10, 2)
  basisValue          Decimal? @db.Decimal(14, 3)
  basisTotal          Decimal? @db.Decimal(14, 3)
  sharePercentage     Decimal? @db.Decimal(9, 6)
  basisUnit           String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  amount          Decimal  @db.Decimal(10, 2)
  method          String
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Ticket {
  id          String       @id @default(cuid())
  apartmentId String
  title       String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  apartment Apartment @relation(fields: [apartmentId], references: [id])
}

model Announcement {
  id            String   @id @default(cuid())
  associationId String
  title         String
  content       String
  createdAt     DateTime @default(now())

  association Association @relation(fields: [associationId], references: [id])
}